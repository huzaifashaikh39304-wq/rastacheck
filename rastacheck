<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>RastaCheck — DK & Udupi Pothole Reporter</title>
  <style>
    :root { --bg: #0f172a; --card: #1e293b; --accent: #f59e0b; --text: #f8fafc; --muted: #94a3b8; }
    * { box-sizing: border-box; font-family: system-ui, -apple-system, sans-serif; }
    body { margin: 0; background: var(--bg); color: var(--text); padding: 20px; }
    .container { max-width: 650px; margin: 0 auto; }
    header { border-bottom: 1px solid #334155; padding-bottom: 12px; margin-bottom: 24px; }
    h1 { margin: 0; color: var(--accent); font-size: 1.75rem; }
    p.sub { margin: 4px 0 0; color: var(--muted); font-size: 0.95rem; }
    .card { background: var(--card); padding: 20px; border-radius: 10px; margin-bottom: 24px; border: 1px solid #334155; }
    label { display: block; margin-bottom: 6px; font-weight: 600; font-size: 0.9rem; }
    input, select, textarea { width: 100%; padding: 10px; margin-bottom: 16px; border-radius: 6px; border: 1px solid #475569; background: #0f172a; color: var(--text); }
    button { background: var(--accent); color: #000; font-weight: 700; border: none; padding: 12px 18px; border-radius: 6px; cursor: pointer; width: 100%; font-size: 1rem; }
    button:hover { opacity: 0.9; }
    .report-item { border-bottom: 1px solid #334155; padding: 12px 0; }
    .report-item:last-child { border-bottom: none; }
    .badge { background: #334155; color: var(--accent); padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: 600; }
    .preview-img { max-width: 100%; height: auto; border-radius: 6px; margin-top: 8px; max-height: 200px; object-fit: cover; }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>RastaCheck</h1>
      <p class="sub">Civic pothole-reporting web app for Dakshina Kannada and Udupi</p>
    </header>

    <div class="card">
      <form id="reportForm">
        <label for="district">District</label>
        <select id="district" required>
          <option value="Dakshina Kannada">Dakshina Kannada</option>
          <option value="Udupi">Udupi</option>
        </select>

        <label for="location">Location / Landmark</label>
        <input type="text" id="location" placeholder="e.g., Near Jyothi Circle, Mangalore or NH-66 Padubidri" required />

        <label for="severity">Severity</label>
        <select id="severity" required>
          <option value="Moderate">Moderate — Slows Down Traffic</option>
          <option value="High">High — Dangerous for Two-Wheelers</option>
          <option value="Critical">Critical — Major Road Damage</option>
        </select>

        <label for="description">Description</label>
        <textarea id="description" rows="3" placeholder="Describe the pothole size, waterlogging, or exact lane..." required></textarea>

        <label for="photo">Photo (Optional)</label>
        <input type="file" id="photo" accept="image/*" />

        <button type="submit">Submit Pothole Report</button>
      </form>
    </div>

    <div class="card">
      <h3 style="margin-top:0;">Recent Local Reports</h3>
      <div id="reportsList"></div>
    </div>
  </div>

  <script>
    const form = document.getElementById('reportForm');
    const reportsList = document.getElementById('reportsList');

    function loadReports() {
      const reports = JSON.parse(localStorage.getItem('rastacheck_reports') || '[]');
      if (reports.length === 0) {
        reportsList.innerHTML = '<p style="color:#94a3b8;font-size:0.9rem;">No reports submitted yet. Add the first one above.</p>';
        return;
      }
      reportsList.innerHTML = reports.map(r => `
        <div class="report-item">
          <div><span class="badge">${r.district}</span> <span class="badge">${r.severity}</span></div>
          <h4 style="margin: 6px 0 4px;">${r.location}</h4>
          <p style="margin: 0 0 6px; color: #cbd5e1; font-size: 0.9rem;">${r.description}</p>
          ${r.photo ? `<img src="${r.photo}" class="preview-img" alt="Pothole photo" />` : ''}
          <small style="color:#64748b; display:block; margin-top:4px;">Reported on ${r.date}</small>
        </div>
      `).join('');
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const fileInput = document.getElementById('photo');
      const saveReport = (photoData) => {
        const reports = JSON.parse(localStorage.getItem('rastacheck_reports') || '[]');
        reports.unshift({
          district: document.getElementById('district').value,
          location: document.getElementById('location').value,
          severity: document.getElementById('severity').value,
          description: document.getElementById('description').value,
          photo: photoData || null,
          date: new Date().toLocaleDateString('en-IN')
        });
        localStorage.setItem('rastacheck_reports', JSON.stringify(reports));
        form.reset();
        loadReports();
      };

      if (fileInput.files && fileInput.files[0]) {
        const reader = new FileReader();
        reader.onload = (event) => saveReport(event.target.result);
        reader.readAsDataURL(fileInput.files[0]);
      } else {
        saveReport(null);
      }
    });

    loadReports();
  </script>
</body>
</html>
